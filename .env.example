# Copiar a .env (ignorado por Git) y completar localmente. Nunca poner valores reales aqui.
# Neon development. Host ficticio: copiar el real de la consola de Neon.
# Para PostgreSQL local: host localhost, base janery, SSL y channel binding en prefer.
JANERY_DB_HOST=ep-ejemplo-123456.c-6.us-east-2.aws.neon.tech
JANERY_DB_PORT=5432
JANERY_DB_NAME=neondb
JANERY_DB_SCHEMA=janery
JANERY_DB_USER=neondb_owner
JANERY_DB_PASSWORD=
# El pooler (-pooler) no conserva SET search_path. Migrar con la conexion directa (sin -pooler).
JANERY_DB_SSLMODE=require
JANERY_DB_CHANNEL_BINDING=require

# Minimo 32 bytes.
JANERY_JWT_SECRET=

JANERY_CORS_ORIGINS=http://localhost:4200
JANERY_SERVER_PORT=8080

JANERY_FLYWAY_ENABLED=true

# Presidente inicial: se crea al arrancar si ese correo no existe.
JANERY_ADMIN_CORREO=
JANERY_ADMIN_PASSWORD=
