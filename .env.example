# Copiar a .env (ignorado por Git) y completar localmente. Nunca poner valores reales aqui.
JANERY_DB_HOST=localhost
JANERY_DB_PORT=5432
JANERY_DB_NAME=janery
JANERY_DB_SCHEMA=janery
JANERY_DB_USER=
JANERY_DB_PASSWORD=

# Minimo 32 bytes.
JANERY_JWT_SECRET=

JANERY_CORS_ORIGINS=http://localhost:4200
JANERY_SERVER_PORT=8080

JANERY_FLYWAY_ENABLED=true

# Presidente inicial: se crea al arrancar si ese correo no existe.
JANERY_ADMIN_CORREO=
JANERY_ADMIN_PASSWORD=
